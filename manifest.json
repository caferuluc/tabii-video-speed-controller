{
  "manifest_version": 2,
  "name": "Tabii Video Speed Controller",
  "version": "1.0",
  "description": "Adjust video playback speed between 0.5x and 4.0x.",
  "permissions": ["<all_urls>", "storage"],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}